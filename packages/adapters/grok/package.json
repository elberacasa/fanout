{
  "name": "fanout-adapter-grok",
  "version": "0.8.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elberacasa/fanout.git",
    "directory": "packages/adapters/grok"
  },
  "homepage": "https://github.com/elberacasa/fanout#readme",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "manifest.json",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "node ../../../scripts/prepack.mjs"
  },
  "dependencies": {
    "fanout-core": "workspace:*",
    "zod": "4.6.2"
  }
}
