{
  "name": "fanout-daemon",
  "version": "0.7.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elberacasa/fanout.git",
    "directory": "packages/daemon"
  },
  "homepage": "https://github.com/elberacasa/fanout#readme",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "node ../../scripts/prepack.mjs"
  },
  "dependencies": {
    "fanout-core": "workspace:*",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "fanout-adapter-fake": "workspace:*",
    "@types/ws": "^8.18.1"
  }
}
