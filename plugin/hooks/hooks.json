{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --disable-warning=ExperimentalWarning \"${CLAUDE_PLUGIN_ROOT}/../packages/cli/src/cli.ts\" status 2>/dev/null || true",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --disable-warning=ExperimentalWarning \"${CLAUDE_PLUGIN_ROOT}/../packages/cli/src/cli.ts\" owed 2>/dev/null || true",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
